# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas ----
# Atlas > Database > Connect > Drivers. Replace <user>, <password>, <cluster>.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/modern-fashion-store?retryWrites=true&w=majority

# ---- Auth ----
# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Admin account created by `npm run seed` ----
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=choose_a_strong_password

# ---- Razorpay (Dashboard > Settings > API Keys, Test Mode) ----
# Leave blank to disable online payments (Cash on Delivery still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard > Webhooks secret, for the /api/payments/webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

# ---- Store rules (rupees) ----
FREE_SHIPPING_THRESHOLD=1999
SHIPPING_FEE=99

# ---- Store details (used on invoices, emails and policy pages) ----
STORE_NAME=Modern Fashion Store
STORE_EMAIL=care@yourstore.com
STORE_PHONE=+91 00000 00000
STORE_ADDRESS=Your registered business address, City, State PIN
# State of your registered GST address: decides CGST+SGST (same state) vs IGST (other states)
STORE_STATE=Maharashtra
# Leave blank until you have a GSTIN; invoices then say "GST registration pending"
STORE_GSTIN=
# PIN code you ship from, used for delivery estimates
WAREHOUSE_PINCODE=400601

# ---- GST on apparel (verify current rates with your CA) ----
# Items with a selling price per piece up to GST_THRESHOLD use GST_RATE_LOW, above it GST_RATE_HIGH
GST_THRESHOLD=2500
GST_RATE_LOW=5
GST_RATE_HIGH=18
SHIPPING_GST_RATE=18

# ---- Email (SMTP). Leave SMTP_HOST blank in development: emails are printed to the server console instead ----
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Modern Fashion Store <no-reply@yourstore.com>"

# ---- Advanced (normally leave unset) ----
# Transactions are detected automatically (MongoDB Atlas supports them). Set true only to force them off.
# DISABLE_TRANSACTIONS=false
# How often unpaid online orders are re-checked with Razorpay, in milliseconds (default 300000 = 5 min)
# PAYMENT_SWEEP_MS=300000
